rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ヘルパー関数: ユーザーが組織のメンバーかチェック
    function isMemberOfOrg(orgId) {
      return exists(/databases/$(database)/documents/organizationMembers/$(getMembershipId(orgId)));
    }

    // ヘルパー関数: メンバーシップIDを取得
    function getMembershipId(orgId) {
      // organizationMembersコレクションをクエリして該当するドキュメントを探す
      // 簡易的なアプローチ: userId_organizationId形式を想定
      return request.auth.uid + '_' + orgId;
    }

    // ヘルパー関数: ユーザーの組織における役割を取得
    // メンバーシップが存在しない場合は空文字を返す（存在しないドキュメントの
    // get() による評価エラーを防ぐ）
    function getOrgRole(orgId) {
      return isMemberOfOrg(orgId)
        ? get(/databases/$(database)/documents/organizationMembers/$(getMembershipId(orgId))).data.role
        : '';
    }

    // ヘルパー関数: 管理者かチェック
    function isOrgAdmin(orgId) {
      return getOrgRole(orgId) == 'admin';
    }

    // ヘルパー関数: メンバーまたは管理者かチェック（書き込み権限）
    function canWriteToOrg(orgId) {
      return getOrgRole(orgId) in ['admin', 'member'];
    }

    // ユーザープロフィール
    match /users/{userId} {
      // 自分のデータは読み書き可能
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // 他のユーザー情報は単体取得のみ（メンバー管理のため）。
      // 全ユーザーの一覧取得（list）は不可
      allow get: if request.auth != null;
      // 旧形式の従業員データ（organizationId = 自分のUID）の移行用に、
      // 自分が所有するドキュメントに限定したクエリのみ許可
      allow list: if request.auth != null &&
                     resource.data.organizationId == request.auth.uid;
    }

    // 組織管理
    match /organizations/{orgId} {
      // 組織メンバーは読み取り可能
      allow read: if request.auth != null && isMemberOfOrg(orgId);
      // 管理者のみ更新可能
      allow update: if request.auth != null && isOrgAdmin(orgId);
      // 認証済みユーザーは新規作成可能
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      // オーナーのみ削除可能
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // 組織メンバーシップ (ドキュメントID形式: userId_organizationId)
    match /organizationMembers/{membershipId} {
      // 自分のメンバーシップまたは同じ組織のメンバーは読み取り可能
      allow get: if request.auth != null &&
                    (membershipId.matches('^' + request.auth.uid + '_.*') ||
                     isMemberOfOrg(resource.data.organizationId));
      // 自分のメンバーシップ、または自分が所属する組織のメンバーのみ検索可能
      allow list: if request.auth != null &&
                     (resource.data.userId == request.auth.uid ||
                      isMemberOfOrg(resource.data.organizationId));
      // 組織作成時の自己追加、または管理者によるメンバー追加
      allow create: if request.auth != null &&
                       (request.resource.data.userId == request.auth.uid ||
                        isOrgAdmin(request.resource.data.organizationId));
      // 管理者のみ更新・削除可能
      allow update, delete: if request.auth != null && isOrgAdmin(resource.data.organizationId);
    }

    // 組織招待
    match /organizationInvitations/{inviteId} {
      // 招待された人は自分宛ての招待を読み取り可能（クエリを含む）
      allow read: if request.auth != null &&
                     (request.auth.token.email == resource.data.email ||
                      isOrgAdmin(resource.data.organizationId));
      // 自分宛ての招待、または自分が管理者である組織の招待のみ検索可能
      allow list: if request.auth != null &&
                     (resource.data.email == request.auth.token.email ||
                      isOrgAdmin(resource.data.organizationId));
      // 管理者のみ招待を作成可能
      allow create: if request.auth != null && isOrgAdmin(request.resource.data.organizationId);
      // 招待された本人または管理者のみ更新可能
      allow update: if request.auth != null &&
                       (request.auth.token.email == resource.data.email ||
                        isOrgAdmin(resource.data.organizationId));
      allow delete: if request.auth != null && isOrgAdmin(resource.data.organizationId);
    }

    // 組織ベースのデータ（作業日誌、圃場、収穫記録など）
    // 共通ルール: 組織メンバーは閲覧可能、管理者・メンバーは編集可能

    match /workLogs/{docId} {
      // 読み取り: organizationIdまたはuserIdでチェック（移行期間中）
      allow read: if request.auth != null &&
                     (('organizationId' in resource.data && isMemberOfOrg(resource.data.organizationId)) ||
                      ('userId' in resource.data && resource.data.userId == request.auth.uid));
      // 作成: organizationIdが必須
      allow create: if request.auth != null && canWriteToOrg(request.resource.data.organizationId);
      // 更新・削除: organizationIdまたはuserIdでチェック
      allow update, delete: if request.auth != null &&
                               (('organizationId' in resource.data && canWriteToOrg(resource.data.organizationId)) ||
                                ('userId' in resource.data && resource.data.userId == request.auth.uid));
    }

    match /fields/{docId} {
      allow read: if request.auth != null &&
                     (('organizationId' in resource.data && isMemberOfOrg(resource.data.organizationId)) ||
                      ('userId' in resource.data && resource.data.userId == request.auth.uid));
      allow create: if request.auth != null && canWriteToOrg(request.resource.data.organizationId);
      allow update, delete: if request.auth != null &&
                               (('organizationId' in resource.data && canWriteToOrg(resource.data.organizationId)) ||
                                ('userId' in resource.data && resource.data.userId == request.auth.uid));
    }

    match /seeds/{docId} {
      allow read: if request.auth != null &&
                     (('organizationId' in resource.data && isMemberOfOrg(resource.data.organizationId)) ||
                      ('userId' in resource.data && resource.data.userId == request.auth.uid));
      allow create: if request.auth != null && canWriteToOrg(request.resource.data.organizationId);
      allow update, delete: if request.auth != null &&
                               (('organizationId' in resource.data && canWriteToOrg(resource.data.organizationId)) ||
                                ('userId' in resource.data && resource.data.userId == request.auth.uid));
    }

    match /seedUses/{docId} {
      allow read: if request.auth != null &&
                     (('organizationId' in resource.data && isMemberOfOrg(resource.data.organizationId)) ||
                      ('userId' in resource.data && resource.data.userId == request.auth.uid));
      allow create: if request.auth != null && canWriteToOrg(request.resource.data.organizationId);
      allow update, delete: if request.auth != null &&
                               (('organizationId' in resource.data && canWriteToOrg(resource.data.organizationId)) ||
                                ('userId' in resource.data && resource.data.userId == request.auth.uid));
    }

    match /fertilizers/{docId} {
      allow read: if request.auth != null &&
                     (('organizationId' in resource.data && isMemberOfOrg(resource.data.organizationId)) ||
                      ('userId' in resource.data && resource.data.userId == request.auth.uid));
      allow create: if request.auth != null && canWriteToOrg(request.resource.data.organizationId);
      allow update, delete: if request.auth != null &&
                               (('organizationId' in resource.data && canWriteToOrg(resource.data.organizationId)) ||
                                ('userId' in resource.data && resource.data.userId == request.auth.uid));
    }

    match /fertilizerUses/{docId} {
      allow read: if request.auth != null &&
                     (('organizationId' in resource.data && isMemberOfOrg(resource.data.organizationId)) ||
                      ('userId' in resource.data && resource.data.userId == request.auth.uid));
      allow create: if request.auth != null && canWriteToOrg(request.resource.data.organizationId);
      allow update, delete: if request.auth != null &&
                               (('organizationId' in resource.data && canWriteToOrg(resource.data.organizationId)) ||
                                ('userId' in resource.data && resource.data.userId == request.auth.uid));
    }

    match /pesticides/{docId} {
      allow read: if request.auth != null &&
                     (('organizationId' in resource.data && isMemberOfOrg(resource.data.organizationId)) ||
                      ('userId' in resource.data && resource.data.userId == request.auth.uid));
      allow create: if request.auth != null && canWriteToOrg(request.resource.data.organizationId);
      allow update, delete: if request.auth != null &&
                               (('organizationId' in resource.data && canWriteToOrg(resource.data.organizationId)) ||
                                ('userId' in resource.data && resource.data.userId == request.auth.uid));
    }

    match /pesticideUses/{docId} {
      allow read: if request.auth != null &&
                     (('organizationId' in resource.data && isMemberOfOrg(resource.data.organizationId)) ||
                      ('userId' in resource.data && resource.data.userId == request.auth.uid));
      allow create: if request.auth != null && canWriteToOrg(request.resource.data.organizationId);
      allow update, delete: if request.auth != null &&
                               (('organizationId' in resource.data && canWriteToOrg(resource.data.organizationId)) ||
                                ('userId' in resource.data && resource.data.userId == request.auth.uid));
    }

    match /harvests/{docId} {
      allow read: if request.auth != null &&
                     (('organizationId' in resource.data && isMemberOfOrg(resource.data.organizationId)) ||
                      ('userId' in resource.data && resource.data.userId == request.auth.uid));
      allow create: if request.auth != null && canWriteToOrg(request.resource.data.organizationId);
      allow update, delete: if request.auth != null &&
                               (('organizationId' in resource.data && canWriteToOrg(resource.data.organizationId)) ||
                                ('userId' in resource.data && resource.data.userId == request.auth.uid));
    }

    match /shipments/{docId} {
      allow read: if request.auth != null &&
                     (('organizationId' in resource.data && isMemberOfOrg(resource.data.organizationId)) ||
                      ('userId' in resource.data && resource.data.userId == request.auth.uid));
      allow create: if request.auth != null && canWriteToOrg(request.resource.data.organizationId);
      allow update, delete: if request.auth != null &&
                               (('organizationId' in resource.data && canWriteToOrg(resource.data.organizationId)) ||
                                ('userId' in resource.data && resource.data.userId == request.auth.uid));
    }

    match /visitors/{docId} {
      allow read: if request.auth != null &&
                     (('organizationId' in resource.data && isMemberOfOrg(resource.data.organizationId)) ||
                      ('userId' in resource.data && resource.data.userId == request.auth.uid));
      allow create: if request.auth != null && canWriteToOrg(request.resource.data.organizationId);
      allow update, delete: if request.auth != null &&
                               (('organizationId' in resource.data && canWriteToOrg(resource.data.organizationId)) ||
                                ('userId' in resource.data && resource.data.userId == request.auth.uid));
    }

    match /trainings/{docId} {
      allow read: if request.auth != null &&
                     (('organizationId' in resource.data && isMemberOfOrg(resource.data.organizationId)) ||
                      ('userId' in resource.data && resource.data.userId == request.auth.uid));
      allow create: if request.auth != null && canWriteToOrg(request.resource.data.organizationId);
      allow update, delete: if request.auth != null &&
                               (('organizationId' in resource.data && canWriteToOrg(resource.data.organizationId)) ||
                                ('userId' in resource.data && resource.data.userId == request.auth.uid));
    }

    match /fieldInspections/{docId} {
      allow read: if request.auth != null &&
                     (('organizationId' in resource.data && isMemberOfOrg(resource.data.organizationId)) ||
                      ('userId' in resource.data && resource.data.userId == request.auth.uid));
      allow create: if request.auth != null && canWriteToOrg(request.resource.data.organizationId);
      allow update, delete: if request.auth != null &&
                               (('organizationId' in resource.data && canWriteToOrg(resource.data.organizationId)) ||
                                ('userId' in resource.data && resource.data.userId == request.auth.uid));
    }

    match /workers/{docId} {
      allow read: if request.auth != null &&
                     (('organizationId' in resource.data && isMemberOfOrg(resource.data.organizationId)) ||
                      ('userId' in resource.data && resource.data.userId == request.auth.uid));
      allow create: if request.auth != null && canWriteToOrg(request.resource.data.organizationId);
      allow update, delete: if request.auth != null &&
                               (('organizationId' in resource.data && canWriteToOrg(resource.data.organizationId)) ||
                                ('userId' in resource.data && resource.data.userId == request.auth.uid));
    }

    match /groups/{docId} {
      allow read: if request.auth != null &&
                     (('organizationId' in resource.data && isMemberOfOrg(resource.data.organizationId)) ||
                      ('userId' in resource.data && resource.data.userId == request.auth.uid));
      allow create: if request.auth != null && canWriteToOrg(request.resource.data.organizationId);
      allow update, delete: if request.auth != null &&
                               (('organizationId' in resource.data && canWriteToOrg(resource.data.organizationId)) ||
                                ('userId' in resource.data && resource.data.userId == request.auth.uid));
    }

    // 作付（栽培サイクル・処理区）
    match /plantings/{docId} {
      allow read: if request.auth != null && isMemberOfOrg(resource.data.organizationId);
      allow create: if request.auth != null && canWriteToOrg(request.resource.data.organizationId);
      allow update, delete: if request.auth != null && canWriteToOrg(resource.data.organizationId);
    }

    // 養液管理記録（EC・pH・水温など）
    match /nutrientLogs/{docId} {
      allow read: if request.auth != null && isMemberOfOrg(resource.data.organizationId);
      allow create: if request.auth != null && canWriteToOrg(request.resource.data.organizationId);
      allow update, delete: if request.auth != null && canWriteToOrg(resource.data.organizationId);
    }

    // 水源・水質検査記録
    match /waterSources/{docId} {
      allow read: if request.auth != null && isMemberOfOrg(resource.data.organizationId);
      allow create: if request.auth != null && canWriteToOrg(request.resource.data.organizationId);
      allow update, delete: if request.auth != null && canWriteToOrg(resource.data.organizationId);
    }

    match /waterTests/{docId} {
      allow read: if request.auth != null && isMemberOfOrg(resource.data.organizationId);
      allow create: if request.auth != null && canWriteToOrg(request.resource.data.organizationId);
      allow update, delete: if request.auth != null && canWriteToOrg(resource.data.organizationId);
    }

    // 資材の保管場所・廃棄記録
    match /storageLocations/{docId} {
      allow read: if request.auth != null && isMemberOfOrg(resource.data.organizationId);
      allow create: if request.auth != null && canWriteToOrg(request.resource.data.organizationId);
      allow update, delete: if request.auth != null && canWriteToOrg(resource.data.organizationId);
    }

    match /materialDisposals/{docId} {
      allow read: if request.auth != null && isMemberOfOrg(resource.data.organizationId);
      allow create: if request.auth != null && canWriteToOrg(request.resource.data.organizationId);
      allow update, delete: if request.auth != null && canWriteToOrg(resource.data.organizationId);
    }

    // 苦情処理・模擬回収テスト記録
    match /complaints/{docId} {
      allow read: if request.auth != null && isMemberOfOrg(resource.data.organizationId);
      allow create: if request.auth != null && canWriteToOrg(request.resource.data.organizationId);
      allow update, delete: if request.auth != null && canWriteToOrg(resource.data.organizationId);
    }

    match /recallTests/{docId} {
      allow read: if request.auth != null && isMemberOfOrg(resource.data.organizationId);
      allow create: if request.auth != null && canWriteToOrg(request.resource.data.organizationId);
      allow update, delete: if request.auth != null && canWriteToOrg(resource.data.organizationId);
    }

    // 機器と校正・点検記録
    match /equipments/{docId} {
      allow read: if request.auth != null && isMemberOfOrg(resource.data.organizationId);
      allow create: if request.auth != null && canWriteToOrg(request.resource.data.organizationId);
      allow update, delete: if request.auth != null && canWriteToOrg(resource.data.organizationId);
    }

    match /equipmentChecks/{docId} {
      allow read: if request.auth != null && isMemberOfOrg(resource.data.organizationId);
      allow create: if request.auth != null && canWriteToOrg(request.resource.data.organizationId);
      allow update, delete: if request.auth != null && canWriteToOrg(resource.data.organizationId);
    }

    // ゴミ箱（削除した記録の一時保管）
    // 完全な削除は管理者のみ。メンバーは削除（ゴミ箱へ移動）と復元ができる。
    match /trash/{docId} {
      allow read: if request.auth != null && isMemberOfOrg(resource.data.organizationId);
      allow create: if request.auth != null && canWriteToOrg(request.resource.data.organizationId);
      allow update: if request.auth != null && canWriteToOrg(resource.data.organizationId);
      allow delete: if request.auth != null && canWriteToOrg(resource.data.organizationId);
    }

    // 教育訓練の項目マスタ（年間計画）
    match /trainingItems/{docId} {
      allow read: if request.auth != null && isMemberOfOrg(resource.data.organizationId);
      allow create: if request.auth != null && canWriteToOrg(request.resource.data.organizationId);
      allow update, delete: if request.auth != null && canWriteToOrg(resource.data.organizationId);
    }

    // 生物多様性モニタリング（定期観察）
    match /biodiversitySurveys/{docId} {
      allow read: if request.auth != null && isMemberOfOrg(resource.data.organizationId);
      allow create: if request.auth != null && canWriteToOrg(request.resource.data.organizationId);
      allow update, delete: if request.auth != null && canWriteToOrg(resource.data.organizationId);
    }

    // 事故・ヒヤリハット記録
    match /incidents/{docId} {
      allow read: if request.auth != null && isMemberOfOrg(resource.data.organizationId);
      allow create: if request.auth != null && canWriteToOrg(request.resource.data.organizationId);
      allow update, delete: if request.auth != null && canWriteToOrg(resource.data.organizationId);
    }

    // 自己点検（内部監査）記録
    match /selfAssessments/{docId} {
      allow read: if request.auth != null && isMemberOfOrg(resource.data.organizationId);
      allow create: if request.auth != null && canWriteToOrg(request.resource.data.organizationId);
      allow update, delete: if request.auth != null && canWriteToOrg(resource.data.organizationId);
    }

    // 清掃項目マスタ
    match /cleaningItems/{docId} {
      allow read: if request.auth != null && isMemberOfOrg(resource.data.organizationId);
      allow create: if request.auth != null && canWriteToOrg(request.resource.data.organizationId);
      allow update, delete: if request.auth != null && canWriteToOrg(resource.data.organizationId);
    }

    // 清掃チェック記録（ドキュメントID: organizationId_YYYY-MM-DD）
    match /cleaningChecks/{docId} {
      allow read: if request.auth != null && isMemberOfOrg(resource.data.organizationId);
      allow create: if request.auth != null && canWriteToOrg(request.resource.data.organizationId);
      allow update: if request.auth != null && canWriteToOrg(resource.data.organizationId);
      allow delete: if request.auth != null && canWriteToOrg(resource.data.organizationId);
    }

    // 肥料の購入（入荷）記録
    match /fertilizerPurchases/{docId} {
      allow read: if request.auth != null && isMemberOfOrg(resource.data.organizationId);
      allow create: if request.auth != null && canWriteToOrg(request.resource.data.organizationId);
      allow update, delete: if request.auth != null && canWriteToOrg(resource.data.organizationId);
    }

    // 母液（原液）の調製記録
    match /stockSolutions/{docId} {
      allow read: if request.auth != null && isMemberOfOrg(resource.data.organizationId);
      allow create: if request.auth != null && canWriteToOrg(request.resource.data.organizationId);
      allow update, delete: if request.auth != null && canWriteToOrg(resource.data.organizationId);
    }

    // 保護具（PPE）の品目マスタ
    match /ppeItems/{docId} {
      allow read: if request.auth != null && isMemberOfOrg(resource.data.organizationId);
      allow create: if request.auth != null && canWriteToOrg(request.resource.data.organizationId);
      allow update, delete: if request.auth != null && canWriteToOrg(resource.data.organizationId);
    }

    // 保護具の入出庫記録（在庫の維持を示す証拠）
    match /ppeTransactions/{docId} {
      allow read: if request.auth != null && isMemberOfOrg(resource.data.organizationId);
      allow create: if request.auth != null && canWriteToOrg(request.resource.data.organizationId);
      allow update, delete: if request.auth != null && canWriteToOrg(resource.data.organizationId);
    }

    // 保護具の着用確認記録（実際に使用されていることを示す証拠）
    match /ppeChecks/{docId} {
      allow read: if request.auth != null && isMemberOfOrg(resource.data.organizationId);
      allow create: if request.auth != null && canWriteToOrg(request.resource.data.organizationId);
      allow update, delete: if request.auth != null && canWriteToOrg(resource.data.organizationId);
    }

    // 作業日誌のマイテンプレート
    match /workLogTemplates/{docId} {
      allow read: if request.auth != null && isMemberOfOrg(resource.data.organizationId);
      allow create: if request.auth != null && canWriteToOrg(request.resource.data.organizationId);
      allow update, delete: if request.auth != null && canWriteToOrg(resource.data.organizationId);
    }

    // 管理者機能（admin roleを持つユーザーのみアクセス可能）
    match /admin/{document=**} {
      allow read, write: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 監査ログ（読み取り専用、管理者のみアクセス可能）
    match /auditLogs/{logId} {
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow create: if request.auth != null;
    }

    // その他のドキュメントは明示的に拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
